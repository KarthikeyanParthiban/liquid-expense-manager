<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SMS permissions for automated expense tracking -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ExpenseApplication"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpenseManager"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ExpenseManager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Real-time SMS Receiver -->
        <receiver
            android:name=".receiver.SmsBroadcastReceiver"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
                <action android:name="com.expensemanager.app.ACTION_SIMULATE_SMS" />
            </intent-filter>
        </receiver>

        <!-- Home Screen App Widget 1: Primary Expense & Burn Rate -->
        <receiver
            android:name=".widget.ExpenseWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.expensemanager.app.widget.ACTION_SYNC_WIDGET" />
                <action android:name="com.expensemanager.app.widget.ACTION_TOGGLE_BALANCE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_expense_summary" />
        </receiver>

        <!-- Home Screen App Widget 2: Category Burn Spectrum -->
        <receiver
            android:name=".widget.CategorySpectrumWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.expensemanager.app.widget.ACTION_SYNC_CATEGORY" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_category_spectrum" />
        </receiver>

        <!-- Home Screen App Widget 3: Cash Flow & Savings Radar -->
        <receiver
            android:name=".widget.CashFlowWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.expensemanager.app.widget.ACTION_SYNC_CASH_FLOW" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_cash_flow" />
        </receiver>

        <!-- Home Screen App Widget 4: Upcoming Bills & Commitments -->
        <receiver
            android:name=".widget.UpcomingBillsWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.expensemanager.app.widget.ACTION_SYNC_BILLS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_upcoming_bills" />
        </receiver>

        <!-- Real-time Financial Notification Listener Service (Google Pay, PhonePe, Paytm, CRED, Bank Apps) -->
        <service
            android:name=".service.ExpenseNotificationListenerService"
            android:label="Liquid Expense Notification Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
