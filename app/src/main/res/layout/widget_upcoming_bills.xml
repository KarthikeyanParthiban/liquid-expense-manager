<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bills_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_titanium_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_bill"
                android:tint="@color/widget_streak_orange"
                android:contentDescription="Bill Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="UPCOMING DUES"
                android:textColor="@color/widget_brand"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_tv_bills_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 Dues"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_btn_sync_bills"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_glass_btn_bg"
                android:padding="4dp"
                android:tint="@color/widget_icon_tint"
                android:src="@drawable/ic_widget_sync"
                android:contentDescription="Sync" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Bills List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <!-- Bill Item 1 -->
        <RelativeLayout
            android:id="@+id/widget_bill1_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_glass_chip_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_tv_bill1_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HDFC Credit Card"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_tv_bill1_due"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Due in 3 days"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_tv_bill1_amt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹ 12,450"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_chip_bill1_urgent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:background="@drawable/widget_chip_bg"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:text="Due Soon"
                    android:textColor="@color/widget_spend_red"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Bill Item 2 -->
        <RelativeLayout
            android:id="@+id/widget_bill2_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_glass_chip_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_tv_bill2_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Groww Mutual Fund SIP"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_tv_bill2_due"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto-debit in 7 days"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_tv_bill2_amt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="₹ 5,000"
                android:textColor="@color/widget_text_primary"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Footer -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/widget_tv_bills_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Total Scheduled: ₹ 17,450"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tv_bills_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Covered by Liquid"
            android:textColor="@color/widget_teal_accent"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </RelativeLayout>

</LinearLayout>
